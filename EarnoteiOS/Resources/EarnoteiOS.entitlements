<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Gemeinsamer Ordner für die Widgets (WidgetSnapshot) -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.app.earnote.Earnote</string>
	</array>
	<!-- Bibliothek über iCloud mit dem Mac abgleichen (Weg B); nur mit eingeschaltetem Schalter in den Einstellungen -->
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.earnote.Earnote</string>
	</array>
	<!-- Stille Mitteilungen von CloudKit: Änderungen vom Mac kommen ohne Öffnen der App an -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Das lokale Sprachmodell braucht mehr als die üblichen App-Grenzen (4B-Modell ab 8 GB, 1.7B-Modell ab 6 GB) -->
	<key>com.apple.developer.kernel.increased-memory-limit</key>
	<true/>
</dict>
</plist>
