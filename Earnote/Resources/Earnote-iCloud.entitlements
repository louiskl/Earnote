<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Wie Earnote.entitlements, zusätzlich iCloud (CloudKit) für die Bibliothek.

  Wird nur benutzt, wenn scripts/Earnote.provisionprofile vorhanden ist. Die Berechtigungen müssen
  genau zu dem passen, was das Profil erlaubt – steht hier eine mehr, verweigert macOS die Signatur.
  Außerhalb des App Store gehört „icloud-container-environment: Production“ dazu.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.application-identifier</key>
	<string>KZJJ4FFKXJ.app.earnote.Earnote</string>
	<key>com.apple.developer.team-identifier</key>
	<string>KZJJ4FFKXJ</string>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.earnote.Earnote</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<!-- Push: Nur so erfährt der Mac sofort von Neuem in iCloud (Aufnahmen vom iPhone, Notizen). Braucht ein Profil mit Push. -->
	<key>com.apple.developer.aps-environment</key>
	<string>production</string>
</dict>
</plist>
