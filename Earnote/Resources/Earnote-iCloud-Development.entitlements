<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nur für den einmaligen Lauf, der das CloudKit-Schema anlegt.

  CloudKit hat zwei getrennte Umgebungen. Eine mit Developer ID signierte App spricht „Production“,
  dort lässt sich aber kein Schema anlegen – das entsteht nur in „Development“ und wird danach in der
  CloudKit-Konsole nach Production übernommen. Deshalb hier „Development“ und keine feste App-ID:
  Die setzt Xcode beim automatischen Signieren selbst ein.
-->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.app.earnote.Earnote</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Development</string>
</dict>
</plist>
